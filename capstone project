        // Convert Numeric Score (0-100) to Letter Grade & 4.0 Grade Point
        function getGradeDetails(score) {
            if (score >= 93) return { letter: 'A', points: 4.0, badge: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
            if (score >= 90) return { letter: 'A-', points: 3.7, badge: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
            if (score >= 87) return { letter: 'B+', points: 3.3, badge: 'bg-sky-50 text-sky-700 border-sky-200' };
            if (score >= 83) return { letter: 'B', points: 3.0, badge: 'bg-sky-50 text-sky-700 border-sky-200' };
            if (score >= 80) return { letter: 'B-', points: 2.7, badge: 'bg-indigo-50 text-indigo-700 border-indigo-200' };
            if (score >= 77) return { letter: 'C+', points: 2.3, badge: 'bg-amber-50 text-amber-700 border-amber-200' };
            if (score >= 70) return { letter: 'C', points: 2.0, badge: 'bg-amber-50 text-amber-700 border-amber-200' };
            if (score >= 60) return { letter: 'D', points: 1.0, badge: 'bg-orange-50 text-orange-700 border-orange-200' };
            return { letter: 'F', points: 0.0, badge: 'bg-rose-50 text-rose-700 border-rose-200' };
        }

        // Compute Weighted CGPA for a Student
        function calculateStudentCGPA(student) {
            if (!student.courses || student.courses.length === 0) return 0.00;
            let totalPoints = 0;
            let totalCredits = 0;
            student.courses.forEach(c => {
                const catalogCourse = COURSE_CATALOG.find(item => item.code === c.code);
                const credits = catalogCourse ? catalogCourse.credits : 3;
                const { points } = getGradeDetails(c.score);
                totalPoints += points * credits;
                totalCredits += credits;
            });
            return totalCredits > 0 ? +(totalPoints / totalCredits).toFixed(2) : 0.00;
        }

        // Compute Attendance Percentage
        function calculateAttendancePct(student) {
            if (!student.totalClasses || student.totalClasses === 0) return 0;
            return +((student.attendedClasses / student.totalClasses) * 100).toFixed(1);
        }

        // Determine Academic Standing
        function getAcademicStanding(cgpa, attendancePct) {
            if (cgpa < 2.30 || attendancePct < 75.0) {
                return { label: 'Academic Probation', style: 'bg-rose-50 text-rose-700 border-rose-200' };
            }
            if (cgpa >= 3.70 && attendancePct >= 85.0) {
                return { label: "Dean's List", style: 'bg-emerald-50 text-emerald-700 border-emerald-200' };
            }
            return { label: 'Good Standing', style: 'bg-sky-50 text-sky-700 border-sky-200' };
        }

