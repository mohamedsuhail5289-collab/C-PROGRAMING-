        // ==================== VIEW 1: DASHBOARD RENDERING ====================

        function renderDashboard() {
            const total = students.length;
            let sumCGPA = 0;
            let sumAtt = 0;
            let deansCount = 0;
            let lowAttCount = 0;

            const tiers = {
                "Dean's Honors (3.70 – 4.00)": { count: 0, color: 'bg-emerald-500' },
                'First Class / Good (3.00 – 3.69)': { count: 0, color: 'bg-brand-600' },
                'Satisfactory (2.30 – 2.99)': { count: 0, color: 'bg-amber-500' },
                'Probation Risk (< 2.30)': { count: 0, color: 'bg-rose-500' }
            };

            const deptCounts = {};
            const alerts = [];
            const deansStudents = [];

            students.forEach(s => {
                const cgpa = calculateStudentCGPA(s);
                const att = calculateAttendancePct(s);
                const standing = getAcademicStanding(cgpa, att);

                sumCGPA += cgpa;
                sumAtt += att;

                if (standing.label === "Dean's List") {
                    deansCount++;
                    deansStudents.push({ ...s, cgpa, att });
                }
                if (att < 75.0) {
                    lowAttCount++;
                    alerts.push({
                        type: 'warning',
                        title: `Low Attendance: ${s.name} (${s.rollNo})`,
                        desc: `Current attendance is ${att}% (Minimum 75% required for exam eligibility).`,
                        studentId: s.id
                    });
                }
                if (cgpa < 2.30) {
                    alerts.push({
                        type: 'danger',
                        title: `Academic Probation: ${s.name} (${s.rollNo})`,
                        desc: `CGPA dropped to ${cgpa.toFixed(2)}. Mandatory advisor intervention required.`,
                        studentId: s.id
                    });
                }

                // Tier bucketing
                if (cgpa >= 3.70) tiers["Dean's Honors (3.70 – 4.00)"].count++;
                else if (cgpa >= 3.00) tiers['First Class / Good (3.00 – 3.69)'].count++;
                else if (cgpa >= 2.30) tiers['Satisfactory (2.30 – 2.99)'].count++;
                else tiers['Probation Risk (< 2.30)'].count++;

                // Dept bucketing
                deptCounts[s.department] = (deptCounts[s.department] || 0) + 1;
            });

            // Update KPIs
            document.getElementById('kpi-total-students').textContent = total;
            document.getElementById('kpi-avg-gpa').textContent = total ? (sumCGPA / total).toFixed(2) : '0.00';
            document.getElementById('kpi-deans-list').textContent = `${deansCount} students on Dean's Honors List`;
            document.getElementById('kpi-avg-attendance').textContent = total ? `${(sumAtt / total).toFixed(1)}%` : '0%';
            document.getElementById('kpi-low-attendance-badge').textContent = `${lowAttCount} below 75%`;
            document.getElementById('kpi-active-courses').textContent = COURSE_CATALOG.length;

            // Render GPA Distribution Bars
            const barsContainer = document.getElementById('gpa-distribution-bars');
            barsContainer.innerHTML = Object.entries(tiers).map(([label, data]) => {
                const pct = total > 0 ? Math.round((data.count / total) * 100) : 0;
                return `
