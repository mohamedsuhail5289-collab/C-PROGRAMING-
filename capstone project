                const courseEntry = s.courses.find(c => c.code === activeCourse.code);
                const gradeInfo = getGradeDetails(courseEntry.score);
                const updatedCGPA = calculateStudentCGPA(s);

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="py-3 px-5 font-mono text-xs font-semibold text-slate-600">${s.rollNo}</td>
                        <td class="py-3 px-4">
                            <div class="font-semibold text-slate-900">${s.name}</div>
                            <div class="text-[11px] text-slate-400">${s.department}</div>
                        </td>
                        <td class="py-3 px-4">
                            <div class="flex items-center gap-2">
                                <input type="number" min="0" max="100" value="${courseEntry.score}"
                                    onchange="updateStudentCourseScore('${s.id}', '${activeCourse.code}', this.value)"
                                    class="w-20 px-2.5 py-1.5 bg-slate-50 border border-slate-200 focus:bg-white focus:border-brand-500 rounded-lg text-xs font-bold text-slate-800 outline-none">
                                <span class="text-xs text-slate-400">/ 100</span>
                            </div>
                        </td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center justify-center w-8 h-6 rounded-md text-xs font-bold border ${gradeInfo.badge}">
                                ${gradeInfo.letter}
                            </span>
                        </td>
                        <td class="py-3 px-4 text-xs font-semibold text-slate-700">${gradeInfo.points.toFixed(1)}</td>
                        <td class="py-3 px-4">
                            <span class="font-display font-bold text-sm text-brand-700">${updatedCGPA.toFixed(2)}</span>
                        </td>
                        <td class="py-3 px-5 text-right">
                            <button onclick="openStudentProfile('${s.id}')" class="text-xs font-semibold text-slate-600 hover:text-brand-600 inline-flex items-center gap-1">
                                <i data-lucide="printer" class="w-3.5 h-3.5"></i> Transcript
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
            lucide.createIcons();
        }

        function selectGradebookCourse(code) {
            selectedCourseCode = code;
            renderGradebook();
        }

        function updateStudentCourseScore(studentId, courseCode, newScoreVal) {
            let score = parseInt(newScoreVal, 10);
            if (isNaN(score)) score = 0;
            score = Math.max(0, Math.min(100, score));

            const student = students.find(s => s.id === studentId);
            if (student) {
                const course = student.courses.find(c => c.code === courseCode);
                if (course) {
                    course.score = score;
                    saveState();
                    refreshAllViews();
                    showToast(`Updated ${student.name}'s ${courseCode} score to ${score}%`);
                }
            }
        }

        // ==================== VIEW 4: ATTENDANCE TRACKER ====================

        function renderAttendanceTracker() {
            const deptFilter = document.getElementById('attendance-dept-filter').value;
            const filtered = students.filter(s => deptFilter === 'ALL' || s.department === deptFilter);

            const tbody = document.getElementById('attendance-tbody');
            tbody.innerHTML = filtered.map(s => {
                const pct = calculateAttendancePct(s);
                const statusColor = pct >= 85 ? 'text-emerald-700 bg-emerald-50' : (pct >= 75 ? 'text-amber-700 bg-amber-50' : 'text-rose-700 bg-rose-50');

                return `
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="py-3.5 px-5 font-mono text-xs font-semibold text-slate-600">${s.rollNo}</td>
                        <td class="py-3.5 px-4 font-semibold text-slate-900">${s.name}</td>
                        <td class="py-3.5 px-4 text-xs text-slate-600">${s.department}</td>
                        <td class="py-3.5 px-4 text-center text-xs font-mono font-semibold text-slate-700">
                            ${s.attendedClasses} / ${s.totalClasses}
                        </td>
                        <td class="py-3.5 px-4">
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold ${statusColor}">
                                ${pct}%
                            </span>
                        </td>
                        <td class="py-3.5 px-5 text-right">
                            <div class="inline-flex items-center gap-1.5">
                                <button onclick="logSingleAttendance('${s.id}', true)" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white border border-emerald-200 transition-colors">
                                    + Present
                                </button>
                                <button onclick="logSingleAttendance('${s.id}', false)" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-50 hover:bg-rose-600 text-rose-700 hover:text-white border border-rose-200 transition-colors">
                                    + Absent
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function logSingleAttendance(studentId, isPresent) {
            const student = students.find(s => s.id === studentId);
            if (!student) return;
            student.totalClasses += 1;
            if (isPresent) student.attendedClasses += 1;
            saveState();
            refreshAllViews();
            showToast(`Marked ${student.name} as ${isPresent ? 'Present' : 'Absent'} (${calculateAttendancePct(student)}%)`);
        }

        function markAllPresent() {
            const deptFilter = document.getElementById('attendance-dept-filter').value;
            let count = 0;
            students.forEach(s => {
                if (deptFilter === 'ALL' || s.department === deptFilter) {
                    s.totalClasses += 1;
                    s.attendedClasses += 1;
                    count++;
                }
            });
            saveState();
            refreshAllViews();
            showToast(`Logged Present session for ${count} students`);
        }

        // ==================== MODAL 1: STUDENT PROFILE & TRANSCRIPT ====================

        function openStudentProfile(studentId) {
            const s = students.find(item => item.id === studentId);
            if (!s) return;

            const cgpa = calculateStudentCGPA(s);
            const att = calculateAttendancePct(s);
            const standing = getAcademicStanding(cgpa, att);
            const initials = s.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();

            document.getElementById('modal-avatar').textContent = initials;
            document.getElementById('modal-student-name').textContent = s.name;
            document.getElementById('modal-student-sub').textContent = `${s.rollNo} • ${s.department} • Semester ${s.semester}`;
            
            const badge = document.getElementById('modal-standing-badge');
            badge.textContent = standing.label;
            badge.className = `text-[11px] font-semibold px-2.5 py-0.5 rounded-full border ${standing.style}`;

            // Metadata fields
            document.getElementById('profile-roll').textContent = s.rollNo;
            document.getElementById('profile-cgpa').textContent = `${cgpa.toFixed(2)} / 4.00`;
            document.getElementById('profile-attendance').textContent = `${att}% (${s.attendedClasses}/${s.totalClasses})`;
            
            let totalCredits = 0;
            const coursesTbody = document.getElementById('profile-courses-tbody');
            coursesTbody.innerHTML = s.courses.map(c => {
                const cat = COURSE_CATALOG.find(item => item.code === c.code) || { title: c.code, credits: 3 };
                const grade = getGradeDetails(c.score);
                totalCredits += cat.credits;

                return `
                    <tr>
                        <td class="py-2.5 px-4 font-mono font-semibold text-slate-700">${c.code}</td>
                        <td class="py-2.5 px-4 font-medium text-slate-800">${cat.title}</td>
                        <td class="py-2.5 px-4 text-center text-slate-600">${cat.credits}</td>
                        <td class="py-2.5 px-4 text-center font-semibold text-slate-700">${c.score}%</td>
                        <td class="py-2.5 px-4 text-center">
                            <span class="inline-block px-2 py-0.5 rounded font-bold border ${grade.badge}">${grade.letter}</span>
                        </td>
                        <td class="py-2.5 px-4 text-right font-semibold text-slate-800">${(grade.points * cat.credits).toFixed(1)}</td>
                    </tr>
                `;
            }).join('');

            document.getElementById('profile-credits').textContent = `${(s.semester - 1) * 16 + totalCredits} Credits`;
            document.getElementById('profile-email').textContent = s.email;
            document.getElementById('profile-phone').textContent = s.phone || 'N/A';
            document.getElementById('profile-advisor').textContent = s.advisor || 'Dr. Alan Vance';
            document.getElementById('profile-batch').textContent = s.batch || 'Fall 2024';
            document.getElementById('profile-notes').textContent = s.notes || 'No advisor notes recorded for current term.';

            // Print metadata
            document.getElementById('print-date').textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
            document.getElementById('print-doc-id').textContent = `TR-${s.rollNo}-${Date.now().toString().slice(-4)}`;

            // Wire Edit button
            document.getElementById('modal-edit-btn').onclick = () => {
                closeProfileModal();
                openEditStudentModal(s.id);
            };

            document.getElementById('profile-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeProfileModal() {
            document.getElementById('profile-modal').classList.add('hidden');
        }

        function printStudentTranscript() {
            window.print();
        }

        // ==================== MODAL 2: ADD / EDIT STUDENT FORM ====================

        function renderFormCourseInputs(existingCourses = []) {
            const container = document.getElementById('form-courses-container');
            // Default to 4 standard courses if enrolling new
            const activeList = existingCourses.length > 0 
                ? existingCourses 
                : [
                    { code: 'CS301', score: 85 },
                    { code: 'CS304', score: 88 },
                    { code: 'DS210', score: 84 },
                    { code: 'BA105', score: 86 }
                ];

            container.innerHTML = COURSE_CATALOG.map(cat => {
                const match = activeList.find(c => c.code === cat.code);
                const isChecked = !!match;
                const scoreVal = match ? match.score : 85;

                return `
                    <div class="flex items-center justify-between p-2.5 rounded-xl border ${isChecked ? 'border-brand-200 bg-brand-50/30' : 'border-slate-200 bg-slate-50/50'}">
                        <label class="flex items-center gap-2 text-xs font-medium text-slate-700 cursor-pointer pr-2">
                            <input type="checkbox" name="enrolled_course" value="${cat.code}" ${isChecked ? 'checked' : ''}
                                class="rounded text-brand-600 focus:ring-brand-500">
                            <span class="truncate" title="${cat.title}"><strong class="font-mono">${cat.code}</strong>: ${cat.title}</span>
                        </label>
                        <input type="number" id="score-${cat.code}" min="0" max="100" value="${scoreVal}"
                            class="w-16 px-2 py-1 bg-white border border-slate-200 rounded-lg text-xs font-bold text-center outline-none focus:border-brand-500">
                    </div>
                `;
            }).join('');
        }

        function openEnrollModal() {
            document.getElementById('enroll-modal-title').textContent = 'Enroll New Student';
            document.getElementById('student-form').reset();
            document.getElementById('form-student-id').value = '';
            document.getElementById('form-roll').value = `ST-2026-${Math.floor(100 + Math.random() * 900)}`;
            renderFormCourseInputs([]);
            document.getElementById('enroll-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function openEditStudentModal(studentId) {
            const s = students.find(item => item.id === studentId);
            if (!s) return;

            document.getElementById('enroll-modal-title').textContent = `Edit Academic Record — ${s.name}`;
            document.getElementById('form-student-id').value = s.id;
            document.getElementById('form-name').value = s.name;
            document.getElementById('form-roll').value = s.rollNo;
            document.getElementById('form-department').value = s.department;
            document.getElementById('form-semester').value = s.semester;
            document.getElementById('form-email').value = s.email;
            document.getElementById('form-phone').value = s.phone || '';
            document.getElementById('form-attended').value = s.attendedClasses;
            document.getElementById('form-total-classes').value = s.totalClasses;
            document.getElementById('form-advisor').value = s.advisor || 'Dr. Alan Vance';
            document.getElementById('form-notes').value = s.notes || '';

            renderFormCourseInputs(s.courses);
            document.getElementById('enroll-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeEnrollModal() {
            document.getElementById('enroll-modal').classList.add('hidden');
        }

        function handleSaveStudent(e) {
            e.preventDefault();
            const id = document.getElementById('form-student-id').value;
            const attended = parseInt(document.getElementById('form-attended').value, 10) || 0;
            const totalClasses = Math.max(1, parseInt(document.getElementById('form-total-classes').value, 10) || 1);

            // Gather selected courses & scores
            const selectedCheckboxes = document.querySelectorAll('input[name="enrolled_course"]:checked');
            const courses = Array.from(selectedCheckboxes).map(cb => {
                const code = cb.value;
                const scoreInput = document.getElementById(`score-${code}`);
                let score = parseInt(scoreInput.value, 10);
                if (isNaN(score)) score = 0;
                score = Math.max(0, Math.min(100, score));
                return { code, score };
            });

            if (courses.length === 0) {
                showToast('Please select at least one enrolled course.', 'error');
                return;
            }

            const studentPayload = {
                id: id || `stu-${Date.now()}`,
                name: document.getElementById('form-name').value.trim(),
                rollNo: document.getElementById('form-roll').value.trim(),
                department: document.getElementById('form-department').value,
                semester: parseInt(document.getElementById('form-semester').value, 10),
                email: document.getElementById('form-email').value.trim(),
                phone: document.getElementById('form-phone').value.trim(),
                attendedClasses: Math.min(attended, totalClasses),
                totalClasses: totalClasses,
                advisor: document.getElementById('form-advisor').value.trim(),
                batch: 'Fall 2026',
                courses,
                notes: document.getElementById('form-notes').value.trim()
            };

            if (id) {
                const idx = students.findIndex(s => s.id === id);
                if (idx !== -1) {
                    studentPayload.batch = students[idx].batch;
                    students[idx] = studentPayload;
                }
                showToast(`Updated academic record for ${studentPayload.name}`);
            } else {
                students.unshift(studentPayload);
                showToast(`Enrolled new student: ${studentPayload.name}`);
            }

            saveState();
            closeEnrollModal();
            refreshAllViews();
        }

        // ==================== RESET DEMO DATA ====================

        function confirmResetDemoData() {
            document.getElementById('reset-modal').classList.remove('hidden');
            lucide.createIcons();
        }

        function executeResetDemoData() {
            students = JSON.parse(JSON.stringify(DEFAULT_STUDENTS));
            saveState();
            document.getElementById('reset-modal').classList.add('hidden');
            refreshAllViews();
            showToast('Institutional demo records restored to default.');
        }
    </script>
</body>
</html>
